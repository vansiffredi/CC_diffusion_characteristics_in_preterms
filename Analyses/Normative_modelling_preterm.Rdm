 ############################# Create all scores for PLSC
```{r data, echo=TRUE}

### Inhibition scores
# A. Inhibition score calculation
data_age$flanker_inhib_RT <- (data_age$Pre_RT_mean_Incong_flanker - data_age$Pre_RT_mean_Cong_flanker)

# B. Inhibition ACC score calculation
data_age$flanker_inhib_ACC <- (data_age$Pre_ACC_Sum_Incong_flanker - data_age$Pre_ACC_Sum_Cong_flanker)

# Age-adjusted
data_age$flanker_inhib_RT_Aadj <- rstandard(lm (data_age$flanker_inhib_RT ~ Pre_Age, data= data_age, na.action="na.exclude"))
data_age$flanker_inhib_ACC_Aadj <- rstandard(lm (data_age$flanker_inhib_ACC ~ Pre_Age, data= data_age, na.action="na.exclude"))
data_age$flanker_Cong_RT_Aadj <- rstandard(lm (Pre_RT_mean_Cong_flanker ~ Pre_Age, data= data_age, na.action="na.exclude"))
data_age$TOM_Aadj <- rstandard(lm (Pre_NB_NEPSY_TE_ToTal ~ Pre_Age, data= data_age, na.action="na.exclude"))
data_age$AR_Aadj <- rstandard(lm (Pre_NB_NEPSY_AR ~ Pre_Age, data= data_age, na.action="na.exclude"))
data_age$SLC_Aadj <- rstandard(lm (Pre_NB_Wisc_V_Mem_leTTre_chiff ~ Pre_Age, data= data_age, na.action="na.exclude"))

# Age & SES-adjusted
data_age$flanker_inhib_RT_SAadj <- rstandard(lm (data_age$flanker_inhib_RT ~ Pre_Age+ SES_largo, data= data_age, na.action="na.exclude"))
data_age$flanker_inhib_ACC_SAadj <- rstandard(lm (data_age$flanker_inhib_ACC ~ Pre_Age+ SES_largo, data= data_age, na.action="na.exclude"))
data_age$flanker_Cong_RT_SAadj <- rstandard(lm (Pre_RT_mean_Cong_flanker ~ Pre_Age+ SES_largo, data= data_age, na.action="na.exclude"))
data_age$TOM_SAadj <- rstandard(lm (Pre_NB_NEPSY_TE_ToTal ~ Pre_Age+ SES_largo, data= data_age, na.action="na.exclude"))
data_age$AR_SAadj <- rstandard(lm (Pre_NB_NEPSY_AR ~ Pre_Age+ SES_largo, data= data_age, na.action="na.exclude"))
data_age$SLC_SAadj <- rstandard(lm (Pre_NB_Wisc_V_Mem_leTTre_chiff ~ Pre_Age+ SES_largo, data= data_age, na.action="na.exclude"))

# SES-adjusted
data_age$AR_NS_Sadj <- rstandard(lm (Pre_NS_NEPSY_AR ~ SES_largo, data= data_age, na.action="na.exclude"))
data_age$SLC_NS_Sadj<- rstandard(lm (Pre_NS_Wisc_V_Mem_leTTre_chif ~ SES_largo, data= data_age, na.action="na.exclude"))
data_age$GeneralCognFunct_Sadj <- rstandard(lm (GeneralCognFunct ~ SES_largo, data= data_age, na.action="na.exclude"))

### Zscore birth weight - get mean+SD
data_age.FT <- subset(data_age, Groups == "FT")
ddply(data_age.FT,~Sexe,summarise,mean=mean(Pds_N, na.rm = TRUE),sd=sd(Pds_N, na.rm = TRUE))

