vol.columnnames <- (volname$colnames.vol.)
# Create new data
vol <-data_age[c("ID")]
# Add w score to the new dataframe
for (i in unique(vol.columnnames)){
name1 <- paste(i,"_z",sep = "")
vol[,name1]<-data_age[,name1]}


### 
behav <-data_age[c("ID","Groups","agebins","SES_largo","BW_zscore","AG_inWeeks","Pds_N","Pre_Age","GeneralCognFunct","Pre_RT_mean_Incong_flanker","Pre_RT_mean_Cong_flanker","Pre_NB_NEPSY_TE_ToTal","Pre_NB_NEPSY_AR","Pre_NS_NEPSY_AR","Pre_NB_Wisc_V_Mem_leTTre_chiff","Pre_NS_Wisc_V_Mem_leTTre_chif","Pre_NB_SDQ_ToTal","Pre_NS_BRIEF_CEG","Pre_NS_BRIEF_IM","Pre_NS_BRIEF_IRC","flanker_inhib_RT","flanker_inhib_ACC","flanker_inhib_RT_Aadj","flanker_inhib_ACC_Aadj","flanker_Cong_RT_Aadj","TOM_Aadj","AR_Aadj","SLC_Aadj","flanker_inhib_RT_SAadj","flanker_inhib_ACC_SAadj","flanker_Cong_RT_SAadj","TOM_SAadj","AR_SAadj","SLC_SAadj","AR_NS_Sadj","SLC_NS_Sadj","GeneralCognFunct_Sadj")]

# Merging data
all_data <- merge(behav,vol,by = "ID")

# Check that all NA are removed
all_data2 <-na.omit(all_data)

# only PT
PT <- subset(all_data, Groups == "PT")
PT2 <-na.omit(PT)


#Inf value in ADC_CC_2_z
PT$ ADC_CC_2_z[PT$ ADC_CC_2_z == "Inf"] <- 0.01
PT$ ADC_CC_2_z[PT$ ADC_CC_2_z == "-Inf"] <- -0.01

# Get variable names
plsvar <- data.frame(colnames(PT))
plsvar <- (plsvar$colnames.PT.)

# create .cvs file for each column in pls
for (i in unique(plsvar)){
  name1 <- paste(i,sep = "")
array <- PT[,name1]
array<- data.frame(array) 

write.table((array),                              
 paste0( "/Users/prepare/Dropbox/2021.02_CCpreterm/01.Data/04.PLSmat/Wscores_VPT_WithinAgeRangeFT/", name1,".csv"),
 row.names=FALSE, col.names=FALSE)}

