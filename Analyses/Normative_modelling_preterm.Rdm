### Load Loadings FT
setwd("/Users/prepare/Dropbox/2021.02_CCpreterm/04.CodeMatlab/myPLS/RESULTS/Raw_FT/")
data <-read.csv("Ub.csv",header = TRUE,sep = ",", na.string = "NA",stringsAsFactors = F)  

### Load Loadings VPT
setwd("/Users/prepare/Dropbox/2021.02_CCpreterm/04.CodeMatlab/myPLS/RESULTS/Raw_VPT/")
data <-read.csv("Ub.csv", header = TRUE,sep = ",",na.string = "NA",stringsAsFactors = F)  

## Load Loadings W-scores VPT
setwd("/Users/prepare/Dropbox/2021.02_CCpreterm/04.CodeMatlab/myPLS/RESULTS/Wscores_VPT_GOOD/")
data <-read.csv("Ub.csv", header = TRUE, sep = ",",na.string = "NA",stringsAsFactors = F)

### Set variables
data$significance <- factor(data$significance,levels = c(0,1), labels = c("notsig","sig"))
data$Variables <- factor(data$Variables, levels =data$Variables[order(data$Correlation)])


### Set themes
generaltheme <- theme(legend.title = element_blank(), axis.text = element_text(size = 11, color="black"), axis.title.y = element_blank(), axis.title.x = element_text(), legend.position = "none", panel.grid.major = element_blank(), panel.grid.minor = element_blank(),panel.background = element_blank(), axis.line = element_line(colour = "black"))


ggplot(data, aes(x=Variables, y=Correlation, label=significance)) + 
  geom_bar(stat='identity', aes(fill=significance), width=.5)  +
  coord_flip()+
  scale_fill_manual(name="significance", 
                    labels = c("sig", "notsig"), 
                    values = c("sig"="#5685e9","notsig"="#A9A9A9"))+
  geom_errorbar(aes(ymin=Correlation-LC_behav_loadings_std, ymax=Correlation+LC_behav_loadings_std), width=.1,
                position=position_dodge(.5), color="grey25") +
  generaltheme +
  theme(panel.grid.major.x = element_line(colour="grey", size=0.3))

```

############################# Illustration Age Normative Modelling
```{r data, echo=TRUE}

#Remove for illustration : 59 - 019_vav_p, CCposterior = 103.3006
data_age <- data_age[-c(59), ] 

## now create some plots of the above
regions <- columnnames
# plot all curves per region per group
Vol <- melt(data_age, id.vars = c("Groups","Pre_Age"), measure.vars = regions)
colnames(Vol) <- c("Group","Age","Region","Value")

generaltheme <- theme(legend.title = element_blank(), axis.text = element_text(size = 11, color="black"), axis.title.y = element_blank(), axis.title.x = element_text(), legend.position = "none", panel.grid.major=element_line(colour="gray92"), panel.grid.minor = element_blank(),panel.background = element_blank(), axis.line = element_line(colour = "black"))


plots <- list()
for(i in unique(Vol$Region)){
  Voltemp <- subset(Vol, Region == i)
  print(paste("working on:",i))

plots[[i]] <- ggplot(Voltemp, aes(x=Age, y=Value, fill = Group)) + # make basic plot
  geom_point(aes(colour = Group), size = 2, alpha = 0.7) + # add scatterplot
  geom_smooth(method=loess,span = 0.4,   # Add local regression line
              se=TRUE) +  # Add shaded confidence region
scale_color_manual(values=c("#56B4E9","#FBC02D"))+
  scale_fill_manual(values=c("#56B4E9","#FBC02D"))+
  generaltheme + theme(text = element_text(size = 20)) + theme(axis.text = element_text(size = 20)) + scale_y_continuous(limits = c(400, 1400), breaks = seq(400,1400,200))}

# To plot graphs: 
plots["CC_Posterior"]


################### Plot errorbar (mean and 2 sd) + dots from PT :) 

# Control vs Preterm data
data_age.PT <- subset(data_age, Groups == "PT")
data_age.FT <- subset(data_age, Groups == "FT")

# Plot
data_age.FT$agebins <- as.factor(data_age.FT$agebins)
sum<- summarySE(data_age.FT, measurevar="FICVF_CC_7", groupvars=c("agebins")) 
sum$A <- sum$FICVF_CC_7
sum$B <- sum$agebins
sum$two.sd <- 2*sum[,4]
pd <- position_dodge(0.1)
 
ggplot(sum, aes(x=B,y=A))+
    geom_errorbar(aes(ymin=A-two.sd, ymax=A+two.sd), width=.1) +
    geom_point(position=pd, size=5)+ 
  geom_point(data = data_age.PT,aes(x=agebins, y= FICVF_CC_7), color='purple', size=2)+
  theme_minimal()

################### Plot errorbar (mean and 1 sd) + dots from PT :) 

# Control vs Preterm data
data_age.PT <- subset(data_age, Groups == "PT")
data_age.FT <- subset(data_age, Groups == "FT")

# Plot Volume CC Posterior
data_age.FT$agebins <- as.factor(data_age.FT$agebins)
sum<- summarySE(data_age.FT, measurevar="CC_Posterior", groupvars=c("agebins")) 
sum$A <- sum$CC_Posterior
sum$B <- sum$agebins
sum$one.sd <- sum[,4]
pd <- position_dodge(0.1)
 
ggplot(sum, aes(x=B,y=A))+
    geom_errorbar(aes(ymin=A-one.sd, ymax=A+one.sd), width=.1, color="#FBC02D", size=3.5) +
    geom_point(position=pd, size=5, color="#FBC02D")+ 
  geom_point(data = data_age.PT,aes(x=agebins, y= CC_Posterior), color="#56B4E9", size=2)+
 generaltheme+ theme(text = element_text(size = 20)) + theme(axis.text = element_text(size = 20)) + scale_y_continuous(limits = c(400, 1400), breaks = seq(400,1400,200))


# Plot FA CC1
data_age.FT$agebins <- as.factor(data_age.FT$agebins)
sum<- summarySE(data_age.FT, measurevar="FA_CC_1", groupvars=c("agebins")) 
sum$A <- sum$FA_CC_1
sum$B <- sum$agebins
sum$one.sd <- sum[,4]
pd <- position_dodge(0.1)
 
ggplot(sum, aes(x=B,y=A))+
    geom_errorbar(aes(ymin=A-one.sd, ymax=A+one.sd), width=.1) +
    geom_point(position=pd, size=5)+ 
  geom_point(data = data_age.PT,aes(x=agebins, y= FA_CC_1), color="#56B4E9", size=2)+
 generaltheme


#### plot z-scores for PT group

zregions <- sapply(columnnames, function(x) paste(x, "_z", sep=""))
PT <- subset(data_age, Groups == "PT")
zVol <- melt(PT, id.vars = c("Pre_Age"), measure.vars = zregions)
colnames(zVol) <- c("Age","Region","ZScore")

plots <- list()
for(i in unique(zVol$Region)){
  zVoltemp <- subset(zVol, Region == i)
  print(paste("working on:",i))
  
plots[[i]] <- ggplot(zVoltemp, aes(x=Age, y=ZScore)) + # make basic plot
  geom_point(colour = "white", fill ="#56B4E9",stroke = 1.5,pch = 21, size = 3,shape = 16, alpha = 0.6) + # add scatterplot
  geom_smooth(method=loess,span = 0.4) +  # Add local regression line
  geom_hline(yintercept=0, linetype="dashed", color = "#FBC02D", size=1.5)+
  generaltheme+ theme(text = element_text(size = 20)) + theme(axis.text = element_text(size = 20)) + scale_y_continuous(limits = c(-5, 5), breaks = seq(-5,5,2.5))}

#Graph: 
plots["CC_Posterior_z"]
  
