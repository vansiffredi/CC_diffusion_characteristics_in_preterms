################### W-score removing preterm out of age range & Export for ################## PLSC
```{r data, echo=TRUE}

#---------------------------------------------
################### W-SCORES CREATION
#---------------------------------------------

setwd("/Users/prepare/Dropbox/2021.02_CCpreterm/02.CodeR/NormativeModelling_MindVaV/")
# load the two functions to get the SD and LOESS coeffient
source("_calcSD.R")
source("_calcLOESS.R")

###### Remove VPT children out of age range for FT
PT <- subset(data, Groups == "PT")
FT <- subset(data, Groups == "FT")
#Age range in FT
range(FT$Pre_Age) # max = 163
#Age range in VPT
range(PT$Pre_Age)
#Explore data
Age <- data$Pre_Age
Age [ Age > 163.5 ] <- NA
#Remove participant outside of age range
data.original <- data
data <- subset(data, Age < 163.5)   #6 participants remove


######Back to normative modelling

# select the columns that we want to compute z-scores on
vol <- data[c("CC_Anterior","CC_Mid_Anterior","CC_Central","CC_Mid_Posterior","CC_Posterior","wmcorrected_CC_Anterior","wmcorrected_CC_Mid_Anterior","wmcorrected_CC_Central","wmcorrected_CC_Mid_Posterior","wmcorrected_CC_Posterior","FA_CC_1","FA_CC_2","FA_CC_3","FA_CC_4","FA_CC_5","FA_CC_6","FA_CC_7","ADC_CC_1","ADC_CC_2","ADC_CC_3","ADC_CC_4","ADC_CC_5","ADC_CC_6","ADC_CC_7","ODI_CC_1",	"ODI_CC_2",	"ODI_CC_3",	"ODI_CC_4",	"ODI_CC_5",	"ODI_CC_6",	"ODI_CC_7",	"FICVF_CC_1",	"FICVF_CC_2",	"FICVF_CC_3",	"FICVF_CC_4",	"FICVF_CC_5",	"FICVF_CC_6",	"FICVF_CC_7",	"FISO_CC_1",	"FISO_CC_2",	"FISO_CC_3",	"FISO_CC_4",	"FISO_CC_5",	"FISO_CC_6",	"FISO_CC_7")]
volname <- data.frame(colnames(vol))
columnnames <- (volname$colnames.vol.)

#Count number of NA
row.has.na <- apply(vol, 1, function(x){any(is.na(x))})
sum(row.has.na)

# order the data by age
data_age <- data[order(data$Pre_Age),]

# split the data into equal size age bins so that we can allign the data later and do some subsetting
# Age range = 72 to 163 // 71.5 to 163.5
# total months = 91 months to divide // 92
# division of age 91/4= 22.75 // 91/4= 23
# division of age 91/3= 30.33

agerange <- seq(71.5, 163.5, 23)
data_age$agebins <- cut(data_age$Pre_Age, agerange)
data_age$numbins <- as.numeric(data_age$agebins)

ddply(data_age,~Groups+agebins,summarise, freq=length(Groups))

# Control vs Preterm data
data_age.PT <- subset(data_age, Groups == "PT")
data_age.FT <- subset(data_age, Groups == "FT")

print("Calculating W-Scores")
# now in a loop compute the scores for all males
for (i in unique(columnnames)) {
  print(paste("working on:",i))
  # get the normative scores for that columns 
  normativeScores <- calcLOESS(data_age.FT[,i],data_age.FT$Pre_Age)

  ctltest <- data.frame(agebins = data_age.FT$agebins, normativeScores)

  # need to check for bins that only have one value as they won't provide a standard deviation
  test <- summarySE(ctltest, measurevar = "Mu", groupvars = "agebins")
  test <- subset(test, N > 2)

  normative <- ctltest %>% group_by(agebins) %>% summarise_all(mean)
  colnames(normative) <- c("agebins",paste(i,"_mu",sep = ""),paste(i,"_sd",sep = ""))

  keepBins <- match(test$agebins, normative$agebins)
  normative <- normative[keepBins,]
  # in the ASD data compute a z-score for FIQ based on the normative data.
  # first add the normative data to the ASD data
  data_age.PT <- merge(data_age.PT,normative, by = "agebins")
  # then compute the z-score
  name1 <- paste(i,"_mu",sep = "")
  name2 <- paste(i,"_sd",sep = "")
  name3 <- paste(i,"_z",sep = "")

  data_age.PT[,name3] <- ((data_age.PT[,i]-data_age.PT[,name1])/data_age.PT[,name2])
  data_age.PT[,name1] <- NULL
  data_age.PT[,name2] <- NULL

  # add the normative scores to the original as well
  colnames(normativeScores) <- c(name1, name2)
  data_age.FT[,name1] <- normativeScores[,name1]
  data_age.FT[,name2] <- normativeScores[,name2]
  data_age.FT[,name3] <- ((data_age.FT[,i]-data_age.FT[,name1])/data_age.FT[,name2])
}

data_age <- rbind.fill(data_age.PT, data_age.FT)
rm(data_age.PT, data_age.FT)

#Create atypical categories
for (i in unique(columnnames)){
  name1 <- paste(i,"_mu",sep = "")
  name2 <- paste(i,"_sd",sep = "")
  name3 <- paste(i,"_z",sep = "")
  name4 <- paste(i,"_atypic",sep = "")
 
data_age[,name4] <- data_age[,name3]
x <- data_age[,name3]
x[ x > 2 ] <- 5
x[ x < -2 ] <- 6
x[ x < 2 ] <- 7

data_age[,name4] <- x
data_age[,name4] <- factor(data_age[,name4], levels = c(5,6,7), labels = c("Above","Below","Norm"))
}

save(data_age,volname,file = paste("Wscores_VPT_WithinAgeRange.RData",sep=""))
rm(i, name1, name2, name3, normativeScores, normative, ctltest)


## now create some plots of the above
regions <- columnnames
# plot all curves per region per group
pcol <- viridis(2)
Vol <- melt(data_age, id.vars = c("Groups","Pre_Age"), measure.vars = regions)
colnames(Vol) <- c("Group","Age","Region","Value")

plots <- list()
for(i in unique(Vol$Region)){
  Voltemp <- subset(Vol, Region == i)
  print(paste("working on:",i))

plots[[i]] <- ggplot(Voltemp, aes(x=Age, y=Value, fill = Group)) + # make basic plot
  geom_point(aes(colour = Group), size = 3, alpha = 0.7) + # add scatterplot
  geom_smooth(method=loess,span = 0.4,   # Add local regression line
              se=TRUE) +  # Add shaded confidence region
              scale_color_manual(values=pcol) +
              scale_fill_manual(values=pcol) +
  theme_minimal() +
  ggtitle(paste("Region:",i)) +
  theme(text = element_text(size = 18),
        plot.background = element_rect(fill="white"),
        panel.background = element_rect(fill="white"),
        axis.text.y = element_text(color="black", size=rel(1)),
        axis.text.x = element_text(color="black", size=rel(1)),
        axis.title.x = element_text(color="black", size=rel(1)),
        axis.title.y = element_text(color="black", size=rel(1)),
        panel.grid.minor.x = element_blank(),
        panel.grid.major.x = element_blank(),
        legend.title = element_blank(),
        legend.text = element_text(color="black", size=rel(0.7)),
        legend.background = element_rect(fill="white"),
        legend.position = "bottom",
        plot.title = element_text(color="black",hjust = 0.5))
}

#Save Plots
print("Printing local regression plots")

pdf(paste("SmoothedCurves_VPT_WithinAgeRangeFT.pdf",sep=""), onefile = TRUE, paper = "a4r")
for (i in seq(length(plots))) {
   print(plots[[i]])
 }
 dev.off()
rm(pcol,plots,i,Vol,Voltemp)

# plot z-scores for PT group
zregions <- sapply(columnnames, function(x) paste(x, "_z", sep=""))
PT <- subset(data_age, Groups == "PT")
zVol <- melt(PT, id.vars = c("Pre_Age"), measure.vars = zregions)
colnames(zVol) <- c("Age","Region","ZScore")
pcol <- viridis(1)

plots <- list()
for(i in unique(zVol$Region)){
  zVoltemp <- subset(zVol, Region == i)
  print(paste("working on:",i))

plots[[i]] <- ggplot(zVoltemp, aes(x=Age, y=ZScore)) + # make basic plot
  geom_point(colour = "white", fill = pcol,
             stroke = 1.5,pch = 21, size = 3,shape = 16, alpha = 0.6) + # add scatterplot
  geom_smooth(method=loess,span = 0.4,   # Add local regression line
              se=TRUE) +  # Add shaded confidence region
              theme_minimal() +
              ggtitle(paste("Region:",i)) +
              theme(text = element_text(size = 18),
                    plot.background = element_rect(fill="white"),
                    panel.background = element_rect(fill="white"),
                    axis.text.y = element_text(color="black", size=rel(1)),
                    axis.text.x = element_text(color="black", size=rel(1)),
                    axis.title.x = element_text(color="black", size=rel(1)),
                    axis.title.y = element_text(color="black", size=rel(1)),
                    panel.grid.minor.x = element_blank(),
                    panel.grid.major.x = element_blank(),
                    legend.title = element_blank(),
                    legend.text = element_text(color="black", size=rel(0.7)),
                    legend.background = element_rect(fill="white"),
                    legend.position = "bottom",
                    plot.title = element_text(color="black",hjust = 0.5))}

#Save as PDF
print("Printing z-score plots")
 pdf(paste("PT_Wscores_WithinAgeRangeFT.pdf",sep=""), onefile = TRUE, paper = "a4r")
for (i in seq(length(plots))) {
   print(plots[[i]])
 }
 dev.off()
 rm(zregions,zVol,plots,i,zVoltemp, pcol)


